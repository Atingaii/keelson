{
  "name": "keelson",
  "version": "0.1.0",
  "description": "A load-bearing workflow layer for AI coding agents: specs as truth, scoped rules, session memory, effort-tiered subagents. Init once, then just talk.",
  "type": "module",
  "bin": {
    "keelson": "bin/keelson.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "hooks",
    "registry",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "node --check bin/keelson.js && for f in src/**/*.js src/*.js hooks/*.mjs; do node --check \"$f\" || exit 1; done",
    "validate": "node bin/keelson.js validate",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "spec-driven",
    "workflow",
    "agent-skills",
    "subagents"
  ],
  "author": "Atingaii",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atingaii/keelson.git"
  },
  "bugs": {
    "url": "https://github.com/Atingaii/keelson/issues"
  },
  "homepage": "https://github.com/Atingaii/keelson#readme"
}
