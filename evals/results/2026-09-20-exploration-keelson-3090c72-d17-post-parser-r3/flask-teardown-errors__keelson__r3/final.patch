+def test_teardown_errors_are_collected(app):
+    events = []
+    errors = [
+        ValueError("request callback"),
+        LookupError("request callback"),
+        TypeError("request signal"),
+        RuntimeError("app callback"),
+        KeyError("app callback"),
+        OSError("app signal"),
+    ]
+
+    @app.teardown_request
+    def request_first(exc):
+        events.append("request first")
+        raise errors[1]
+
+    @app.teardown_request
+    def request_second(exc):
+        events.append("request second")
+        raise errors[0]
+
+    @app.teardown_appcontext
+    def app_first(exc):
+        events.append("app first")
+        raise errors[4]
+
+    @app.teardown_appcontext
+    def app_second(exc):
+        events.append("app second")
+        raise errors[3]
+
+    def request_signal(sender, exc):
+        events.append("request signal")
+        raise errors[2]
+
+    def request_signal_after_error(sender, exc):
+        events.append("request signal after error")
+
+    def app_signal(sender, exc):
+        events.append("app signal")
+        raise errors[5]
+
+    def app_signal_after_error(sender, exc):
+        events.append("app signal after error")
+
+    flask.request_tearing_down.connect(request_signal, app)
+    flask.request_tearing_down.connect(request_signal_after_error, app)
+    flask.appcontext_tearing_down.connect(app_signal, app)
+    flask.appcontext_tearing_down.connect(app_signal_after_error, app)
+    outer = flask.Flask("outer")
+
+    try:
+        with outer.app_context():
+            if sys.version_info >= (3, 11):
+                with pytest.raises(BaseExceptionGroup) as info:
+                    with app.test_request_context():
+                        pass
+
+                assert info.value.exceptions == tuple(errors)
+            else:
+                with pytest.raises(ValueError) as info:
+                    with app.test_request_context():
+                        pass
+
+                assert info.value is errors[0]
+
+            assert flask.current_app._get_current_object() is outer
+    finally:
+        flask.request_tearing_down.disconnect(request_signal, app)
+        flask.request_tearing_down.disconnect(request_signal_after_error, app)
+        flask.appcontext_tearing_down.disconnect(app_signal, app)
+        flask.appcontext_tearing_down.disconnect(app_signal_after_error, app)
+
