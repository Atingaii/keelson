 in funcs:\n+            try:\n+                self.ensure_sync(func)(exc)\n+            except BaseException as e:\n+                errors.append(e)\n+\n+        if signal.is_muted:\n+            return\n+\n+        for receiver in signal.receivers_for(self):\n+            try:\n+                self.ensure_sync(receiver)(self, exc=exc)\n+            except BaseException as e:\n+                errors.append(e)\n+\n+    @staticmethod\n+    def _raise_teardown_errors(errors: list[BaseException]) -> None:\n+        \"\"\"Raise teardown errors after all registered cleanup has run.\"\"\"\n+        if not errors:\n+            return\n+\n+        exception_group = getattr(builtins, \"BaseExceptionGroup\", None)\n+\n+        if exception_group is None:\n+            raise errors[0]\n+\n+        raise exception_group(\"teardown errors\", errors)\n \n     def do_teardown_appcontext(\n         self, ctx: AppContext, exc: BaseException | None = None\n@@ -1454,10 +1500,17 @@ class Flask(App):\n \n         .. versionadded:: 0.9\n         \"\"\"\n-        for func in reversed(self.teardown_appcontext_funcs):\n-            self.ensure_sync(func)(exc)\n+        errors: list[BaseException] = []\n+        self._do_teardown_appcontext(ctx, exc, errors)\n+        self._raise_teardown_errors(errors)\n \n-        appcontext_tearing_down.send(self, _async_wrapper=self.ensure_sync, exc=exc)\n+    def _do_teardown_appcontext(\n+        self, ctx: AppContext, exc: BaseException | None, errors: list[BaseException]\n+    ) -> None:\n+        \"\"\"Run application-context teardown callbacks and signal receivers.\"\"\"\n+        self._call_teardown_callbacks(\n+            reversed(self.teardown_appcontext_funcs), appcontext_tearing_down, exc, errors\n+        )\n \n     def app_context(self) -> AppContext:\n         \"\"\"Create an :class:`.AppContext`. When the context is pushed,\ndiff --git a/src/flask/ctx.py b/src/flask/ctx.py\nindex 8876efd..7e6f499 100644\n--- a/src/flask/ctx.py\n+++ b