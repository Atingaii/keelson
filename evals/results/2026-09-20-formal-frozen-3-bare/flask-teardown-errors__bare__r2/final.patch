+def test_app_teardown_runs_all_functions_and_signal_receivers(app):
+    called = []
+
+    @app.teardown_appcontext
+    def first_teardown(exc):
+        called.append("first teardown")
+        raise RuntimeError("first teardown")
+
+    @app.teardown_appcontext
+    def second_teardown(exc):
+        called.append("second teardown")
+        raise RuntimeError("second teardown")
+
+    def first_receiver(sender, exc):
+        called.append("first receiver")
+        raise RuntimeError("first receiver")
+
+    def second_receiver(sender, exc):
+        called.append("second receiver")
+        raise RuntimeError("second receiver")
+
+    flask.appcontext_tearing_down.connect(first_receiver, app)
+    flask.appcontext_tearing_down.connect(second_receiver, app)
+
+    try:
+        if sys.version_info >= (3, 11):
+            with pytest.raises(BaseExceptionGroup) as info:
+                with app.app_context():
+                    pass
+
+            assert {str(error) for error in info.value.exceptions} == set(called)
+        else:
+            with pytest.raises(RuntimeError):
+                with app.app_context():
+                    pass
+    finally:
+        flask.appcontext_tearing_down.disconnect(first_receiver, app)
+        flask.appcontext_tearing_down.disconnect(second_receiver, app)
+
+    assert set(called) == {
+        "first teardown",
+        "second teardown",
+        "first receiver",
+        "second receiver",
+    }
+    assert not flask.current_app
+
+
