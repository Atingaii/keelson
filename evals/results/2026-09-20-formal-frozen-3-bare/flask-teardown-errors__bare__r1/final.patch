+def test_request_teardown_runs_all_callbacks_and_signal_after_error(app):
+    called = []
+
+    @app.teardown_request
+    def first_teardown(exc):
+        called.append("first")
+        raise ValueError("first")
+
+    @app.teardown_request
+    def second_teardown(exc):
+        called.append("second")
+        raise KeyError("second")
+
+    @app.teardown_appcontext
+    def app_teardown(exc):
+        called.append("app")
+        raise RuntimeError("app")
+
+    def record_request_signal(sender, exc):
+        called.append("request signal")
+
+    def record_app_signal(sender, exc):
+        called.append("app signal")
+
+    flask.request_tearing_down.connect(record_request_signal, app)
+    flask.appcontext_tearing_down.connect(record_app_signal, app)
+    try:
+        if sys.version_info >= (3, 11):
+            with pytest.raises(BaseExceptionGroup) as e:
+                with app.test_request_context():
+                    pass
+
+            assert [type(error) for error in e.value.exceptions] == [
+                KeyError,
+                ValueError,
+                RuntimeError,
+            ]
+        else:
+            with pytest.raises(KeyError, match="second"):
+                with app.test_request_context():
+                    pass
+    finally:
+        flask.request_tearing_down.disconnect(record_request_signal, app)
+        flask.appcontext_tearing_down.disconnect(record_app_signal, app)
+
+    assert called == ["second", "first", "request signal", "app", "app signal"]
+    assert not flask.current_app
+    assert not flask.request
+
+
