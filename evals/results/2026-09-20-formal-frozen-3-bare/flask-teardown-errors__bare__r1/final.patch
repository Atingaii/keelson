+def _raise_teardown_errors(errors: list[BaseException]) -> None:
+    if not errors:
+        return
+
+    if sys.version_info >= (3, 11):
+        raise BaseExceptionGroup("teardown failed", errors)
+
+    raise errors[0]
+
+
+def _call_teardown_functions(
+    functions: t.Iterable[t.Callable[[], t.Any]],
+) -> None:
+    """Call teardown functions, collecting errors until cleanup is complete."""
+    errors: list[BaseException] = []
+
+    for function in functions:
+        try:
+            function()
+        except BaseException as e:
+            errors.append(e)
+
+    _raise_teardown_errors(errors)
+
+
+def _append_teardown_error(errors: list[BaseException], error: BaseException) -> None:
+    if sys.version_info >= (3, 11) and isinstance(error, BaseExceptionGroup):
+        errors.extend(error.exceptions)
+    else:
+        errors.append(error)
