--- a/tests/test_appctx.py
+++ b/tests/test_appctx.py
@@ -1,3 +1,5 @@
+import sys
+
 import pytest
 
 import flask
@@ -53,6 +55,60 @@ def test_app_tearing_down(app):
     assert cleanup_stuff == [None]
 
 
+def test_app_teardown_runs_all_callbacks_and_signal(app):
+    called = []
+
+    @app.teardown_appcontext
+    def first(exc):
+        called.append("first")
+        raise ValueError("first")
+
+    @app.teardown_appcontext
+    def second(exc):
+        called.append("second")
+        raise LookupError("second")
+
+    def signal(sender, exc):
+        called.append("signal")
+        raise RuntimeError("signal")
+
+    flask.appcontext_tearing_down.connect(signal, app)
+    try:
+        if sys.version_info >= (3, 11):
+            with pytest.raises(BaseExceptionGroup) as info:
+                app.do_teardown_appcontext(app.app_context())
+
+            assert [type(e) for e in info.value.exceptions] == [
+                LookupError,
+                ValueError,
+                RuntimeError,
+            ]
+        else:
+            with pytest.raises(LookupError):
+                app.do_teardown_appcontext(app.app_context())
+    finally:
+        flask.appcontext_tearing_down.disconnect(signal, app)
+
+    assert called == ["second", "first", "signal"]
+
+
+def test_app_context_is_reset_after_teardown_error(app):
+    @app.teardown_appcontext
+    def fail(exc):
+        raise RuntimeError("teardown failed")
+
+    if sys.version_info >= (3, 11):
+        error = BaseExceptionGroup
+    else:
+        error = RuntimeError
+
+    with pytest.raises(error):
+        with app.app_context():
+            pass
+
+    assert not flask.current_app
+
+
 def test_app_tearing_down_with_previous_exception(app):
     cleanup_stuff = []
 
