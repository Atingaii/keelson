+def _call_teardown_functions(
+    funcs: t.Iterable[t.Callable[[], t.Any]],
+) -> list[BaseException]:
+    """Call teardown functions, collecting errors without interrupting cleanup."""
+    errors = []
+
+    for func in funcs:
+        try:
+            func()
+        except BaseException as e:
+            errors.append(e)
+
+    return errors
+
+
+def _raise_teardown_errors(errors: list[BaseException]) -> None:
+    """Raise errors collected while running teardown functions."""
+    if not errors:
+        return
+
+    if sys.version_info >= (3, 11):
+        raise BaseExceptionGroup("errors occurred during teardown", errors)
+
+    raise errors[0]
+
