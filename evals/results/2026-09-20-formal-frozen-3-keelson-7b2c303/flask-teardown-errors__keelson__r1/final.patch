+def test_app_teardown_runs_all_callbacks_and_signal_receivers(app):
+    calls = []
+
+    @app.teardown_appcontext
+    def callback_error(error):
+        calls.append("callback error")
+        raise ValueError("callback error")
+
+    @app.teardown_appcontext
+    def callback_done(error):
+        calls.append("callback done")
+
+    def signal_error(sender, exc):
+        calls.append("signal error")
+        raise KeyError("signal error")
+
+    def signal_done(sender, exc):
+        calls.append("signal done")
+
+    flask.appcontext_tearing_down.connect(signal_error, app)
+    flask.appcontext_tearing_down.connect(signal_done, app)
+
+    try:
+        with pytest.raises(Exception) as info:
+            with app.app_context():
+                pass
+    finally:
+        flask.appcontext_tearing_down.disconnect(signal_error, app)
+        flask.appcontext_tearing_down.disconnect(signal_done, app)
