xt_funcs), exc, appcontext_tearing_down\n+        )\n+\n+    def _call_teardown_functions(\n+        self,\n+        funcs: cabc.Iterable[ft.TeardownCallable],\n+        exc: BaseException | None,\n+        signal: t.Any,\n+    ) -> None:\n+        \"\"\"Run teardown callbacks and their signal, collecting any errors.\"\"\"\n+        errors = []\n+\n+        for func in funcs:\n+            try:\n+                self.ensure_sync(func)(exc)\n+            except BaseException as e:\n+                errors.append(e)\n+\n+        try:\n+            signal.send(self, _async_wrapper=self.ensure_sync, exc=exc)\n+        except BaseException as e:\n+            errors.append(e)\n+\n+        self._raise_teardown_errors(errors)\n+\n+    @staticmethod\n+    def _raise_teardown_errors(errors: list[BaseException]) -> None:\n+        if len(errors) == 1:\n+            raise errors[0]\n+\n+        if errors:\n+            if sys.version_info >= (3, 11):\n+                raise BaseExceptionGroup(\"teardown errors\", errors)\n \n-        appcontext_tearing_down.send(self, _async_wrapper=self.ensure_sync, exc=exc)\n+            raise errors[0]\n \n     def app_context(self) -> AppContext:\n         \"\"\"Create an :class:`.AppContext`. When the context is pushed,\ndiff --git a/src/flask/ctx.py b/src/flask/ctx.py\nindex 8876efd..b7f2638 100644\n--- a/src/flask/ctx.py\n+++ b/src/flask/ctx.py\n@@ -482,15 +482,34 @@ class AppContext:\n         if self._push_count > 0:\n             return\n \n-        try:\n-            if self._request is not None:\n+        errors: list[BaseException] = []\n+\n+        if self._request is not None:\n+            try:\n                 self.app.do_teardown_request(self, exc)\n+            except BaseException as e:\n+                errors.append(e)\n+\n+            try:\n                 self._request.close()\n-        finally:\n+            except BaseException as e:\n+                errors.append(e)\n+\n+        try:\n             self.app.do_tear