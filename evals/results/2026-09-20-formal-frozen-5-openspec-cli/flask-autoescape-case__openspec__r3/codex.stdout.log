e -->\\n\\n- [ ] 2.1 <!-- Task description -->\\n- [ ] 2.2 <!-- Task description -->\\n\",\n  \"dependencies\": [\n    {\n      \"id\": \"specs\",\n      \"done\": true,\n      \"path\": \"specs/**/*.md\",\n      \"description\": \"Detailed specifications for the change\"\n    },\n    {\n      \"id\": \"design\",\n      \"done\": false,\n      \"path\": \"design.md\",\n      \"description\": \"Technical design document with implementation details\"\n    }\n  ],\n  \"unlocks\": [],\n  \"root\": {\n    \"path\": \"/workspace\",\n    \"source\": \"nearest\"\n  }\n}\n","exit_code":0,"status":"completed"}}
