+                assert not flask.request
+                return 42
+
+            greenlets.append(greenlet(g))
+            return "Hello World!"
+
+        rv = client.get("/?foo=bar")
+        assert rv.data == b"Hello World!"
+
+        result = greenlets[0].run()
+        assert result == 42
