+import sys
+import warnings
+
+import pytest
+
+import flask
+from flask.globals import app_ctx
+from flask.sessions import SecureCookieSessionInterface
+from flask.sessions import SessionInterface
+
+try:
+    from greenlet import greenlet
+except ImportError:
+    greenlet = None
+
+
+def test_teardown_on_pop(app):
+    buffer = []
+
+    @app.teardown_request
+    def end_of_request(exception):
+        buffer.append(exception)
+
+    ctx = app.test_request_context()
+    ctx.push()
+    assert buffer == []
+    ctx.pop()
+    assert buffer == [None]
+
+
+def test_request_teardown_runs_all_callbacks_and_signal_receivers(app):
+    called = []
+
+    @app.teardown_request
+    def first_callback(exc):
+        called.append("first callback")
+        raise ValueError("first callback")
+
+    @app.teardown_request
+    def second_callback(exc):
+        called.append("second callback")
+        raise LookupError("second callback")
+
+    def first_receiver(sender, exc):
+        called.append("first receiver")
+        raise KeyError("first receiver")
+
+    def second_receiver(sender, exc):
+        called.append("second receiver")
+        raise RuntimeError("second receiver")
+
+    flask.request_tearing_down.connect(first_receiver, app)
+    flask.request_tearing_down.connect(second_receiver, app)
+    try:
+        if sys.version_info >= (3, 11):
+            with pytest.raises(BaseExceptionGroup) as info:
+                with app.test_request_context():
+                    pass
+
+            assert {type(e) for e in info.value.exceptions} == {
+                ValueError,
+                LookupError,
+                KeyError,
+                RuntimeError,
+            }
+        else:
+            with pytest.raises(LookupError):
+                with app.test_request_context():
+                    pass
+    finally:
+        flask.request_tearing_down.disconnect(first_receiver, app)
+        flask.request_tearing_down.disconnect(second_receiver, app)
+
+    assert set(called) == {
+        "first callback",
+        "second callback",
+        "first receiver",
+        "second receiver",
+    }
+    assert not flask.current_app
+    assert not flask.request
+
