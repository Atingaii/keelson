+def _call_teardown_callbacks(
+    callbacks: t.Iterable[t.Callable[[], t.Any]],
+    errors: list[BaseException] | None = None,
+) -> list[BaseException]:
+    if errors is None:
+        errors = []
+
+    for callback in callbacks:
+        try:
+            callback()
+        except BaseException as e:
+            errors.append(e)
+
+    return errors
+
+
+def _raise_teardown_errors(errors: list[BaseException]) -> None:
+    if not errors:
+        return
+
+    if sys.version_info >= (3, 11):
+        raise BaseExceptionGroup("errors occurred during teardown", errors)
+
+    raise errors[0]
+
