+def _teardown_error_types(error):
+    if sys.version_info >= (3, 11):
+        assert isinstance(error, BaseExceptionGroup)
+        errors = error.exceptions
+    else:
+        errors = (error,)
+
+    types = set()
+
+    for item in errors:
+        if sys.version_info >= (3, 11) and isinstance(item, BaseExceptionGroup):
+            types.update(_teardown_error_types(item))
+        else:
+            types.add(type(item))
+
+    return types
+
+
+def _expected_teardown_error_types():
+    if sys.version_info >= (3, 11):
+        return {KeyError, LookupError, TypeError, ValueError}
+
+    return {KeyError}
