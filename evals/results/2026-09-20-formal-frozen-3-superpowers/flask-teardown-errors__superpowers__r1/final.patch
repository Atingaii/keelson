diff --git a/tests/test_appctx.py b/tests/test_appctx.py
index a537b05..be89561 100644
--- a/tests/test_appctx.py
+++ b/tests/test_appctx.py
@@ -1,3 +1,5 @@
+import sys
+
 import pytest
 
 import flask
@@ -208,3 +210,75 @@ def test_clean_pop(app):
 
     assert called == ["flask_test", "TEARDOWN"]
     assert not flask.current_app
+
+
+def test_teardown_continues_after_errors_and_resets_context(app):
+    called = []
+
+    @app.teardown_request
+    def request_teardown_after_error(exc):
+        called.append("request callback after error")
+
+    @app.teardown_request
+    def request_teardown_error(exc):
+        called.append("request callback error")
+        raise ValueError("request callback error")
+
+    @app.teardown_appcontext
+    def app_teardown_after_error(exc):
+        called.append("app callback after error")
+
+    @app.teardown_appcontext
+    def app_teardown_error(exc):
+        called.append("app callback error")
+        raise ValueError("app callback error")
+
+    def request_signal_error(sender, exc):
+        called.append("request signal error")
+        raise ValueError("request signal error")
+
+    def app_signal_error(sender, exc):
+        called.append("app signal error")
+        raise ValueError("app signal error")
+
+    def app_popped_signal_error(sender):
+        called.append("app popped signal error")
+        assert not flask.current_app
+        raise ValueError("app popped signal error")
+
+    flask.request_tearing_down.connect(request_signal_error, app)
+    flask.appcontext_tearing_down.connect(app_signal_error, app)
+    flask.appcontext_popped.connect(app_popped_signal_error, app)
+
+    try:
+        if sys.version_info >= (3, 11):
+            with pytest.raises(BaseExceptionGroup) as info:
+                with app.test_request_context():
+                    pass
+        else:
+            with pytest.raises(ValueError, match="request callback error"):
+                with app.test_request_context():
+                    pass
+    finally:
+        flask.request_tearing_down.disconnect(request_signal_error, app)
+        flask.appcontext_tearing_down.disconnect(app_signal_error, app)
+        flask.appcontext_popped.disconnect(app_popped_signal_error, app)
+
+    if sys.version_info >= (3, 11):
+        assert {str(error) for error in info.value.exceptions} == {
+            "request callback error",
+            "request signal error",
+            "app callback error",
+            "app signal error",
+            "app popped signal error",
+        }
+    assert called == [
+        "request callback error",
+        "request callback after error",
+        "request signal error",
+        "app callback error",
+        "app callback after error",
+        "app signal error",
+        "app popped signal error",
+    ]
+    assert not flask.current_app
