{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.keelson/hooks/session-start.mjs\"",
            "timeout": 10
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.keelson/hooks/prompt-state.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
